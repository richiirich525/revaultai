{
  "trailingSlash": false,
  "functions": {
    "api/verify-models.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/premium-prompts",
      "destination": "/premium-films",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon-32.png",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/film/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/creator/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(settings|admin|set-password|email-confirmed|purchase-success|vault|takes|projects|specs|finish)",
      "destination": "/index.html"
    },
    {
      "source": "/world/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/receipt/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/casting/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/prompts/(.*)",
      "destination": "/index.html"
    }
  ]
}
