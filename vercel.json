{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/premium-prompts",
      "destination": "/premium-films",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/film/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/creator/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(settings|admin|set-password|email-confirmed|purchase-success|vault|takes|projects|specs)",
      "destination": "/index.html"
    }
  ]
}
